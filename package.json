{
  "name": "plasticina-portable",
  "version": "0.1.0",
  "private": true,
  "description": "Aplicación de escritorio estática para Plasticina, construida con HTML, CSS y JavaScript",
  "main": "desktop/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "build:linux": "bash builds/linux_builds/export_appimage.sh",
    "build:windows": "bash builds/windows_builds/export_zip.sh",
    "test": "node test/run.js",
    "test:static": "python3 test/check_static.py"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "cl.plasticina.portable",
    "productName": "Plasticina",
    "asar": true,
    "npmRebuild": false,
    "compression": "maximum",
    "directories": {
      "output": "builds/.cache"
    },
    "files": [
      "index.html",
      "assets/**/*",
      "!assets/tests/**/*",
      "desktop/**/*",
      "!plasticina-master/**/*",
      "!builds/**/*",
      "!test/**/*",
      "!node_modules/**/*"
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        }
      ],
      "artifactName": "Plasticina-${version}-linux-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": ["x64"]
        }
      ],
      "artifactName": "Plasticina-${version}-win-${arch}.${ext}"
    }
  }
}
